<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="f450">

  <!-- ========================================================= -->
  <!-- MATERIALS                                                  -->
  <!-- ========================================================= -->

  <!-- Light-gray F450 body -->
  <material name="frame_gray">
    <color rgba="0.65 0.67 0.70 1.0"/>
  </material>

  <!-- Red arms -->
  <material name="arm_red">
    <color rgba="0.85 0.02 0.02 1.0"/>
  </material>

  <!-- Silver motors -->
  <material name="motor_silver">
    <color rgba="0.75 0.77 0.80 1.0"/>
  </material>

  <!-- White / light-gray propellers -->
  <material name="propeller_white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>

  <!-- Battery -->
  <material name="battery_gray">
    <color rgba="0.18 0.20 0.22 1.0"/>
  </material>

  <!-- Jetson -->
  <material name="jetson_gray">
    <color rgba="0.32 0.34 0.37 1.0"/>
  </material>

  <!-- D435 -->
  <material name="camera_gray">
    <color rgba="0.68 0.70 0.73 1.0"/>
  </material>

  <!-- T265 -->
  <material name="t265_gray">
    <color rgba="0.40 0.42 0.45 1.0"/>
  </material>

  <!-- Landing legs -->
  <material name="leg_gray">
    <color rgba="0.72 0.74 0.76 1.0"/>
  </material>


  <!-- ========================================================= -->
  <!-- MAIN F450 BODY                                             -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/base_link.STL"
          scale="1 1 1"/>
      </geometry>

      <material name="frame_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/base_link.STL"
          scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>

      <mass value="0.3784"/>

      <inertia
        ixx="0.002"
        ixy="0"
        ixz="0"
        iyy="0.002"
        iyz="0"
        izz="0.003"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- FRONT RED ARM                                              -->
  <!-- ========================================================= -->

  <link name="front_arm_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/front_arm_link.STL"
          scale="1 1 1"/>
      </geometry>

      <material name="arm_red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/front_arm_link.STL"
          scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>

      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="front_arm_joint" type="fixed">

    <origin
      xyz="0.09809149 0.09809149 0.171"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="front_arm_link"/>

  </joint>


  <!-- ========================================================= -->
  <!-- BACK RED ARM                                               -->
  <!-- ========================================================= -->

  <link name="back_arm_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/back_arm_link.STL"
          scale="1 1 1"/>
      </geometry>

      <material name="arm_red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/back_arm_link.STL"
          scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>

      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="back_arm_joint" type="fixed">

    <origin
      xyz="-0.09809149 -0.09809149 0.171"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="back_arm_link"/>

  </joint>


  <!-- ========================================================= -->
  <!-- BATTERY - ON TOP                                           -->
  <!-- ========================================================= -->

  <link name="battery_link">

  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh
        filename="package://f450/meshes/battery_link.STL"
        scale="0.884 1.433 0.476"/>
    </geometry>
    <material name="battery_gray"/>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh
        filename="package://f450/meshes/battery_link.STL"
        scale="1 1 1"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.260"/>
    <inertia
      ixx="0.001"
      ixy="0"
      ixz="0"
      iyy="0.001"
      iyz="0"
      izz="0.001"/>
  </inertial>

</link>

<joint name="battery_joint" type="fixed">
  <origin
    xyz="-0.025435 -0.00022216 0.11"
    rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="battery_link"/>
</joint>

   <!-- ========================================================= -->
  <!-- RASPBERRY PI 4 MODEL B - 4 GB RAM                         -->
  <!-- Mounted on the lower/base plate                           -->
  <!-- ========================================================= -->

  <link name="raspberry_pi_4_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Approximate board dimensions: 85 x 56 x 17 mm -->
        <box size="0.085 0.056 0.017"/>
      </geometry>
      <material name="raspberry_pi_green">
        <color rgba="0.12 0.38 0.20 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.085 0.056 0.017"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.046"/>
      <inertia
        ixx="0.000010"
        ixy="0"
        ixz="0"
        iyy="0.000030"
        iyz="0"
        izz="0.000030"/>
    </inertial>

  </link>

  <joint name="raspberry_pi_4_joint" type="fixed">
    <!-- Below the main body center, on the base plate -->
    <origin xyz="0 0 0.143" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="raspberry_pi_4_link"/>
  </joint>


  <!-- ========================================================= -->
  <!-- PIXHAWK 2.4.8 FLIGHT CONTROLLER                           -->
  <!-- Mounted on the upper/top plate                            -->
  <!-- ========================================================= -->

  <link name="pixhawk_248_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Approximate controller-board representation -->
        <box size="0.050 0.050 0.015"/>
      </geometry>
      <material name="pixhawk_black">
        <color rgba="0.18 0.18 0.20 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.050 0.015"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.038"/>
      <inertia
        ixx="0.002"
        ixy="0"
        ixz="0"
        iyy="0.002"
        iyz="0"
        izz="0.002"/>
    </inertial>

  </link>

  <joint name="pixhawk_248_joint" type="fixed">
    <!-- Above the main body, on the top plate -->
    <origin xyz="0 0 0.180" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="pixhawk_248_link"/>
  </joint>

    <!-- ========================================================= -->
  <!-- ESC 1 - FRONT RIGHT ARM                                   -->
  <!-- ========================================================= -->

  <link name="esc1_link">
    <visual>
      <geometry>
        <box size="0.045 0.025 0.012"/>
      </geometry>
      <material name="esc_gray">
        <color rgba="0.20 0.20 0.22 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="esc1_joint" type="fixed">
    <origin xyz="0.125 0.125 0.155" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="esc1_link"/>
  </joint>


  <!-- ========================================================= -->
  <!-- ESC 2 - REAR LEFT ARM                                     -->
  <!-- ========================================================= -->

  <link name="esc2_link">
    <visual>
      <geometry>
        <box size="0.045 0.025 0.012"/>
      </geometry>
      <material name="esc_gray"/>
    </visual>
  </link>

  <joint name="esc2_joint" type="fixed">
    <origin xyz="-0.125 -0.125 0.155" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="esc2_link"/>
  </joint>


  <!-- ========================================================= -->
  <!-- ESC 3 - FRONT LEFT ARM                                    -->
  <!-- ========================================================= -->

  <link name="esc3_link">
    <visual>
      <geometry>
        <box size="0.045 0.025 0.012"/>
      </geometry>
      <material name="esc_gray"/>
    </visual>
  </link>

  <joint name="esc3_joint" type="fixed">
    <origin xyz="0.125 -0.125 0.155" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="esc3_link"/>
  </joint>


  <!-- ========================================================= -->
  <!-- ESC 4 - REAR RIGHT ARM                                    -->
  <!-- ========================================================= -->

  <link name="esc4_link">
    <visual>
      <geometry>
        <box size="0.045 0.025 0.012"/>
      </geometry>
      <material name="esc_gray"/>
    </visual>
  </link>

  <joint name="esc4_joint" type="fixed">
    <origin xyz="-0.125 0.125 0.155" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="esc4_link"/>
  </joint>

  <!-- ========================================================= -->
  <!-- D435 CAMERA - FRONT AND BELOW BODY                         -->
  <!-- ========================================================= -->

  <link name="d435_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/d435_link.STL"
          scale="1 1 1"/>
      </geometry>

      <material name="camera_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/d435_link.STL"
          scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>

      <mass value="0.10"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>

  <!-- D435 mounting joint -->
  <joint name="d435_joint" type="fixed">

    <!-- Front = negative Y -->
    <!-- Camera below body -->
 <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="d435_link"/>

  </joint>


  <!-- ========================================================= -->
  <!-- T265 CAMERA                                                -->
  <!-- ========================================================= -->

  <link name="t265_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/t265_link.STL"
          scale="1 1 1"/>
      </geometry>

      <material name="t265_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/t265_link.STL"
          scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>

      <mass value="0.10"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>

  <joint name="t265_joint" type="fixed">

    <origin
      xyz="0.082405 -0.008628 0.118529"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="t265_link"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LANDING LEGS                                               -->
  <!-- ========================================================= -->

  <link name="leg_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/leg_link.STL"
          scale="1 1 1"/>
      </geometry>

      <material name="leg_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/leg_link.STL"
          scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>

      <mass value="0.05"/>

      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="leg_joint" type="fixed">

    <origin
      xyz="0 0 0.132"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="leg_link"/>

  </joint>


  <!-- ========================================================= -->
  <!-- PROP GUARD - HIDDEN                                        -->
  <!-- ========================================================= -->

  <link name="prop_guard_link">

    <visual>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>

      <material name="frame_gray"/>

    </visual>

    <inertial>
      <origin xyz="0 0 0"/>

      <mass value="0.01"/>

      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00001"
        iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>

  <joint name="prop_guard_joint" type="fixed">

    <origin
      xyz="0 0.000037 0.171"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="prop_guard_link"/>

  </joint>


  <!-- ========================================================= -->
  <!-- MOTOR 1 - FRONT RIGHT                                      -->
  <!-- ========================================================= -->

  <link name="motor1_link">

    <visual>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.018"
          length="0.035"/>
      </geometry>

      <material name="motor_silver"/>

    </visual>

    <collision>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.018"
          length="0.035"/>
      </geometry>

    </collision>

    <inertial>
      <origin xyz="0 0 0"/>

      <mass value="0.02"/>

      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00001"
        iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>

  <joint name="motor1_joint" type="fixed">

    <origin
      xyz="0.15988 0.15988 0.173"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="motor1_link"/>

  </joint>


  <!-- ========================================================= -->
  <!-- ROTOR 1 - DIRECTLY ON MOTOR 1                              -->
  <!-- ========================================================= -->

  <link name="rotor1">
    <inertial>
      <mass value="0.005"/>
      <inertia
        ixx="0.000001"
        ixy="0"
        ixz="0"
        iyy="0.000001"
        iyz="0"
        izz="0.000002"/>
    </inertial>


    <visual>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/rotor1.STL"
          scale="0.65 0.65 0.65"/>
      </geometry>

      <material name="propeller_white"/>

    </visual>

  </link>

  <joint name="rotor1_joint" type="continuous">

    <!-- Rotor sits directly on top of motor -->
    <origin
      xyz="0 0 0.020"
      rpy="0 0 0"/>

    <parent link="motor1_link"/>
    <child link="rotor1"/>

    <axis xyz="0 0 1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- MOTOR 2 - BACK LEFT                                        -->
  <!-- ========================================================= -->

  <link name="motor2_link">

    <visual>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.018"
          length="0.035"/>
      </geometry>

      <material name="motor_silver"/>

    </visual>

    <collision>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.018"
          length="0.035"/>
      </geometry>

    </collision>

    <inertial>
      <origin xyz="0 0 0"/>

      <mass value="0.02"/>

      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00001"
        iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>

  <joint name="motor2_joint" type="fixed">

    <origin
      xyz="-0.15988 -0.15988 0.173"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="motor2_link"/>

  </joint>


  <!-- ROTOR 2 -->

  <link name="rotor2">
    <inertial>
      <mass value="0.005"/>
      <inertia
        ixx="0.000001"
        ixy="0"
        ixz="0"
        iyy="0.000001"
        iyz="0"
        izz="0.000002"/>
    </inertial>


    <visual>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/rotor1.STL"
          scale="0.65 0.65 0.65"/>
      </geometry>

      <material name="propeller_white"/>

    </visual>

  </link>

  <joint name="rotor2_joint" type="continuous">

    <origin
      xyz="0 0 0.020"
      rpy="0 0 0"/>

    <parent link="motor2_link"/>
    <child link="rotor2"/>

    <axis xyz="0 0 1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- MOTOR 3 - FRONT LEFT                                       -->
  <!-- ========================================================= -->

  <link name="motor3_link">

    <visual>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.018"
          length="0.035"/>
      </geometry>

      <material name="motor_silver"/>

    </visual>

    <collision>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.018"
          length="0.035"/>
      </geometry>

    </collision>

    <inertial>
      <origin xyz="0 0 0"/>

      <mass value="0.02"/>

      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00001"
        iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>

  <joint name="motor3_joint" type="fixed">

    <origin
      xyz="0.15988 -0.15988 0.173"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="motor3_link"/>

  </joint>


  <!-- ROTOR 3 -->

  <link name="rotor3">
    <inertial>
      <mass value="0.005"/>
      <inertia
        ixx="0.000001"
        ixy="0"
        ixz="0"
        iyy="0.000001"
        iyz="0"
        izz="0.000002"/>
    </inertial>


    <visual>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/rotor1.STL"
          scale="0.65 0.65 0.65"/>
      </geometry>

      <material name="propeller_white"/>

    </visual>

  </link>

  <joint name="rotor3_joint" type="continuous">

    <origin
      xyz="0 0 0.020"
      rpy="0 0 0"/>

    <parent link="motor3_link"/>
    <child link="rotor3"/>

    <axis xyz="0 0 1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- MOTOR 4 - BACK RIGHT                                       -->
  <!-- ========================================================= -->

  <link name="motor4_link">

    <visual>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.018"
          length="0.035"/>
      </geometry>

      <material name="motor_silver"/>

    </visual>

    <collision>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.018"
          length="0.035"/>
      </geometry>

    </collision>

    <inertial>
      <origin xyz="0 0 0"/>

      <mass value="0.02"/>

      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00001"
        iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>

  <joint name="motor4_joint" type="fixed">

    <origin
      xyz="-0.15988 0.15988 0.173"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="motor4_link"/>

  </joint>


  <!-- ROTOR 4 -->

  <link name="rotor4">
    <inertial>
      <mass value="0.005"/>
      <inertia
        ixx="0.000001"
        ixy="0"
        ixz="0"
        iyy="0.000001"
        iyz="0"
        izz="0.000002"/>
    </inertial>


    <visual>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://f450/meshes/rotor1.STL"
          scale="0.65 0.65 0.65"/>
      </geometry>

      <material name="propeller_white"/>

    </visual>

  </link>

  <joint name="rotor4_joint" type="continuous">

    <origin
      xyz="0 0 0.020"
      rpy="0 0 0"/>

    <parent link="motor4_link"/>
    <child link="rotor4"/>

    <axis xyz="0 0 1"/>

  </joint>


</robot>


